<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberway.mp.demo.backenddemo.domain.order.repository.OrderRepository">

    <resultMap id="OrderResultMap" type="com.cyberway.mp.demo.backenddemo.domain.order.entity.Order">
        <id property="id" column="id"/>
        <result property="createdUserId" column="created_user_id"/>
        <result property="createdUserName" column="created_user_name"/>
        <result property="createdTime" column="created_time"/>
        <result property="lastModifiedUserId" column="last_modified_user_id"/>
        <result property="lastModifiedUserName" column="last_modified_user_name"/>
        <result property="lastModifiedTime" column="last_modified_time"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="businessZoneId" column="business_zone_id"/>
        <result property="appInstanceId" column="app_instance_id"/>
        <result property="orderNo" column="order_no"/>
        <result property="customerId" column="customer_id"/>
        <result property="amount" column="amount"/>
        <result property="status" column="status"/>
    </resultMap>

    <sql id="OrderColumns">
        id,
        created_user_id,
        created_user_name,
        created_time,
        last_modified_user_id,
        last_modified_user_name,
        last_modified_time,
        tenant_id,
        business_zone_id,
        app_instance_id,
        order_no,
        customer_id,
        amount,
        status
    </sql>

    <sql id="OrderFilters">
        <where>
            <if test="query.orderNoLike != null and query.orderNoLike != ''">
                and order_no like concat('%', #{query.orderNoLike}, '%')
            </if>
            <if test="query.customerId != null">
                and customer_id = #{query.customerId}
            </if>
            <if test="query.status != null">
                and status = #{query.status}
            </if>
        </where>
    </sql>

    <select id="countOrder" resultType="long">
        select count(1)
        from backend_demo_order
        <include refid="OrderFilters"/>
    </select>

    <select id="searchOrder" resultMap="OrderResultMap">
        select
        <include refid="OrderColumns"/>
        from backend_demo_order
        <include refid="OrderFilters"/>
        order by created_time desc, id desc
        limit #{pageParam.pageSize} offset #{pageParam.offset}
    </select>

    <select id="countByOrderNoExcludingId" resultType="long">
        select count(1)
        from backend_demo_order
        where order_no = #{orderNo}
          and id &lt;&gt; #{id}
    </select>
</mapper>
