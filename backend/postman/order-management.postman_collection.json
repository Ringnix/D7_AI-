              "pm.test('Feign 保留订单不存在语义', () => {",
              "  pm.response.to.have.status(404);",
              "  pm.expect(pm.response.json().errorCode).to.eql('90000102');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
