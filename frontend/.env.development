VITE_BASE_URL = './'
VITE_PORT = 3000
# 接口前缀，本地开发时由 Vite 代理转发
VITE_BASE_API = '/api'
# 订单服务 A 地址，/api/orders 请求会被代理到这里（新增、修改、删除）
VITE_PROXY_ORDER_API = 'http://127.0.0.1:8081'
# 订单调用服务 B 地址，/api/consumer 请求会被代理到这里，再由 B 通过 Feign 调用 A（列表、详情）
VITE_PROXY_CONSUMER_API = 'http://127.0.0.1:8082'
# 中台开发环境地址，用于登录与平台公共接口
VITE_PROXY_PLATFORM_API = 'http://192.168.90.25:46807'
VITE_APP_ID = '126124990557847552'
VITE_ENV = 'local'
