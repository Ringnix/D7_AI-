{
    "name":  "cyberway-mp-order-management-web",
    "version":  "1.23.0",
    "private":  true,
    "description":  "订单管理",
    "scripts":  {
                    "dev":  "vite --mode development",
                    "serve":  "vite preview",
                    "build":  "vite build --watch",
                    "build:test":  "vite build --mode test",
                    "build:dev":  "vite build  --mode dev",
                    "build:prd":  "vite build",
                    "lint":  "eslint src types --ext .ts,.vue",
                    "lint:style":  "stylelint \"src/**/*.{vue,less,css}\"",
                    "format":  "prettier --write \"src/**/*.{ts,vue,less}\"",
                    "uc:serve":  "node scripts/serve-uc.mjs"
                },
    "dependencies":  {
                         "@ant-design/icons-vue":  "^6.1.0",
                         "@vueuse/components":  "^8.2.0",
                         "@vueuse/core":  "10.9.0",
                         "ant-design-vue":  "3.2.0",
                         "axios":  "1.4.0",
                         "core-js":  "^3.20.0",
                         "cyberway-middle-ui-components":  "1.23.0",
                         "cyberway-mp-uc-web":  "1.23.0",
                         "dayjs":  "1.11.10",
                         "insert-css":  "^2.0.0",
                         "js-md5":  "^0.7.3",
                         "lodash":  "4.17.21",
                         "mitt":  "3.0.1",
                         "nprogress":  "^1.0.0-1",
                         "pinia":  "2.0.8",
                         "qs":  "^6.10.2",
                         "sortablejs":  "^1.14.0",
                         "vue":  "3.2.26",
                         "vue-i18n":  "9.13.1",
                         "vue-router":  "4.3.2"
                     },
    "devDependencies":  {
                            "@commitlint/cli":  "^15.0.0",
                            "@commitlint/config-conventional":  "^15.0.0",
                            "@originjs/vite-plugin-federation":  "1.3.5",
                            "@types/cyberway-mp":  "1.22.0",
                            "@types/js-md5":  "^0.4.3",
                            "@types/lodash":  "^4.14.178",
                            "@types/node":  "^17.0.3",
                            "@types/webpack-env":  "^1.16.3",
                            "@typescript-eslint/eslint-plugin":  "^5.4.0",
                            "@typescript-eslint/parser":  "^5.4.0",
                            "@vitejs/plugin-vue":  "^5.0.4",
                            "@vitejs/plugin-vue-jsx":  "3.1.0",
                            "@vue/babel-plugin-jsx":  "^1.1.1",
                            "@vue/eslint-config-prettier":  "^7.1.0",
                            "@vue/eslint-config-typescript":  "^9.1.0",
                            "eslint":  "^7.32.0",
                            "eslint-config-prettier":  "^8.3.0",
                            "eslint-plugin-prettier":  "^4.0.0",
                            "eslint-plugin-vue":  "^8.0.3",
                            "husky":  "^7.0.4",
                            "less":  "^4.1.2",
                            "less-loader":  "10.2.0",
                            "lint-staged":  "^12.1.3",
                            "path-browserify":  "^1.0.1",
                            "postcss-html":  "^1.3.0",
                            "prettier":  "^2.5.1",
                            "prettier-eslint":  "^13.0.0",
                            "stylelint":  "^14.2.0",
                            "stylelint-config-html":  "^1.0.0",
                            "stylelint-config-prettier":  "^9.0.3",
                            "stylelint-config-recommended":  "^6.0.0",
                            "stylelint-config-standard":  "^24.0.0",
                            "stylelint-order":  "^5.0.0",
                            "svg-sprite-loader":  "^6.0.11",
                            "terser":  "5.31.0",
                            "typescript":  "^4.5.4",
                            "vite":  "5.2.10",
                            "vite-plugin-compression":  "0.5.1"
                        },
    "__npminstall_done":  false,
    "engines":  {
                    "node":  "^12 || \u003e=14"
                },
    "lint-staged":  {
                        "*.{js,jsx,ts,tsx}":  [
                                                  "eslint --fix",
                                                  "prettier --write"
                                              ],
                        "{!(package)*.json,*.code-snippets,.!(browserslist)*rc}":  [
                                                                                       "prettier --write--parser json"
                                                                                   ],
                        "package.json":  [
                                             "prettier --write"
                                         ],
                        "*.vue":  [
                                      "eslint --fix",
                                      "prettier --write",
                                      "stylelint --fix"
                                  ],
                        "*.{scss,less,styl,html}":  [
                                                        "stylelint --fix",
                                                        "prettier --write"
                                                    ],
                        "*.md":  [
                                     "prettier --write"
                                 ]
                    },
    "target":  "web"
}